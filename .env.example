EBIRD_API_KEY=your-key-here
SCRAPE_REGION=US-PA-003
SCRAPE_DELAY=0.4

# The checklist database lives in a PRIVATE Hugging Face dataset, not in git.
# eBird records are not redistributable, and this repository is public — but
# the scrape has to accumulate somewhere both a laptop and a CI runner can
# reach, or each one starts from an empty seven-day window every time.
HF_DATASET=your-username/birding-coach-db
HF_TOKEN=hf_your-write-token

# A SECOND, public dataset holding only fitted coefficients. The app
# fetches from it with no token, which is why it cannot be the private one.
# eBird forbids redistributing observations; model output is derived work.
HF_PUBLIC_DATASET=your-username/birding-coach-model
